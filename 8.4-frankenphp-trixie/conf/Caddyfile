{
	skip_install_trust

	servers {
		trusted_proxies {$CADDY_TRUSTED_PROXIES_MODE:static} {$CADDY_TRUSTED_PROXIES_RANGES:private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
		{$CADDY_TRUSTED_PROXIES_CONFIG:trusted_proxies_strict}
		{$CADDY_SERVERS_CONFIG}
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	# https://caddyserver.com/docs/caddyfile/directives#sorting-algorithm
	order php_server before file_server
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:/app/public}
	# Compressed SSE streams cost memory per subscriber and enable BREACH-style attacks.
	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip

	# Like mod_remoteip in the Apache images: PHP gets the visitor IP resolved through
	# trusted_proxies as REMOTE_ADDR, and HTTPS=on when a proxy received the request over HTTPS.
	map {http.request.header.X-Forwarded-Proto} {forwarded_https} {
		https on
		default ""
	}
	map {http.request.scheme} {php_https} {
		https on
		default {forwarded_https}
	}
	# Already resolved into REMOTE_ADDR: don't let PHP walk the proxy chain a second time.
	request_header -X-Forwarded-For

	# /index.php/foo would duplicate /foo (Symfony strips the script name before routing) and slip past proxy
	# rules on /foo: redirect it to the clean URL, with a 308 so a POST stays a POST. redir runs before
	# php_server rewrites requests to index.php.
	# Keep the path prefix a proxy stripped (Traefik's stripprefix sends it as X-Forwarded-Prefix). Only a plain
	# path is accepted: "//evil.com" would make this an open redirect.
	map {http.request.header.X-Forwarded-Prefix} {forwarded_prefix} {
		~^((?:/[\w.~-]+)+)/?$ "${1}"
		default ""
	}
	@index_php path_regexp index_php ^/index\.php(?:/(.*))?$
	redir @index_php {forwarded_prefix}/{re.index_php.1}{?query} 308

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		env REMOTE_ADDR {client_ip}
		env HTTPS {php_https}
	}
}

# Extra site blocks: add *.caddyfile files to /etc/frankenphp/Caddyfile.d instead of replacing this file.
import Caddyfile.d/*.caddyfile
